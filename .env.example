# cp .env.example .env 후 값을 바꿔 쓴다. .env는 커밋하지 않는다(.gitignore)
MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=change-me-s3
S3_BUCKET=jjhg-local

# HS512로 서명하려면 64바이트 이상. 원본 저장소의 secret은 공개돼 있으므로 쓰지 않는다
# 생성: openssl rand -base64 48 | tr -d '\n'   (64자)
JWT_SECRET=
